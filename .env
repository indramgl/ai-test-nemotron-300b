APP_NAME=Personal Finance SaaS
APP_ENV=local
APP_KEY=base64:generate_your_own_key_here
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=personal_finance
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random
JWT_TTL=60