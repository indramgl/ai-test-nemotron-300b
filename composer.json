{
    "name": "personal-finance/saas",
    "description": "Personal Finance SaaS Application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.10",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.19"
        },
        "policy.advisories.ignore-id": ["PKSA-y2cr-5h3j-g3ys"],
        "policy": {
            "advisories": {
                "ignore-id": ["[\"PKSA-y2cr-5h3j-g3ys\"]"]
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 app/",
        "cs-fix": "phpcbf --standard=PSR12 app/"
    }
}
